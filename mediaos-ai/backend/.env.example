# PostgreSQL — əsas məlumat bazası (həqiqət mənbəyi)
MEDIAOS_DATABASE_URL=postgresql+psycopg://mediaos:mediaos@localhost:5432/mediaos
# Redis — yalnız sürət qatı; əlçatmaz olsa sistem PostgreSQL ilə işləyir
MEDIAOS_REDIS_URL=redis://localhost:6379/0

# LLM provayderi: local (oflayn) | anthropic | openai
MEDIAOS_LLM_PROVIDER=local
MEDIAOS_LLM_MODEL=claude-sonnet-5-5
MEDIAOS_LLM_FALLBACK_PROVIDER=local
# ANTHROPIC_API_KEY=...   (anthropic seçildikdə; repoya commit etməyin)
# OPENAI_API_KEY=...      (openai seçildikdə)

# Embeddings: hashing (oflayn) | openai
MEDIAOS_EMBEDDING_PROVIDER=hashing
MEDIAOS_EMBEDDING_DIM=384

# Keş TTL-ləri (saniyə)
MEDIAOS_CACHE_TTL_DASHBOARD=60
MEDIAOS_CACHE_TTL_LATEST_NEWS=30
MEDIAOS_CACHE_TTL_SEARCH=300
MEDIAOS_CACHE_TTL_AI_ANSWER=120
MEDIAOS_RATE_LIMIT_PER_MINUTE=60
MEDIAOS_RATE_LIMIT_CHAT_PER_MINUTE=20

# Collector lentləri: "url|Mənbə adı|növ" (növ: official|media|social|complaint)
# MEDIAOS_COLLECTOR_FEEDS=["https://example.az/rss|Nümunə portal|media"]
MEDIAOS_COLLECTOR_INTERVAL_S=600

# EnsembleData (Instagram + TikTok). Tokeni üstünlüklə admin paneldən daxil edin; bu dəyişən ehtiyat yoldur.
# MEDIAOS_ENSEMBLEDATA_TOKEN=
MEDIAOS_ENSEMBLEDATA_MAX_UNITS_PER_RUN=150
MEDIAOS_ENSEMBLEDATA_INTERVAL_S=3600
# MEDIAOS_ED_INSTAGRAM_OFFICIAL_ACCOUNTS=["hesab_adı"]
